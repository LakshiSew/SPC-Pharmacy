@model IEnumerable<SPC_Server.Models.Tender>

@{
    ViewBag.Title = "GetTenders";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure it uses your layout
}

<div class="container mt-4">
    <h2 class="text-center mb-3 text-info">Tender List</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-secondary">Tender Inventory</h5>
        <a href="@Url.Action("AddTender", "Home")" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Create New Tender
        </a>
    </div>

    <div>
        <table class="table table-striped table-bordered">
            <thead class="bg-info text-white">
                <tr>
                    <th>Tender ID</th>
                    <th>Drug Name</th>
                    <th>Quantity Required</th>
                    <th>Closing Date</th>
                    <th>Status</th>
                    <th>ActionDate</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TenderID)</td>
                        <td>@Html.DisplayFor(modelItem => item.DrugName)</td>
                        <td>@Html.DisplayFor(modelItem => item.QuantityRequired)</td>
                        <td>@item.ClosingDate.ToString("yyyy-MM-dd")</td>

                        <td>
                            <span class="badge @(item.Status == "Open" ? "badge-success" : "badge-danger")">
                                @Html.DisplayFor(modelItem => item.Status)
                            </span>
                        </td>
                  
                        <td>@(item.ActionDate.HasValue ? item.ActionDate.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td class="text-center">
                            <a href="@Url.Action("DeleteTenders", new { id = item.TenderID })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this Tender?');"><i class="fas fa-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
