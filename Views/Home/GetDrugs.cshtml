@model IEnumerable<SPC_Server.Models.Drug>

@{
    ViewBag.Title = "GetDrugs";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensures it uses the main layout
}

<h2 class="text-center mb-3 text-info"><i class="fas fa-pills"></i> Manage Drugs</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="text-secondary">Drug Inventory</h5>
    <a href="@Url.Action("AddDrugs", "Home")" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Add New Drug
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead class="bg-info text-white">
        <tr>
            <th>Drug ID</th>
            <th>Drug Name</th>
            <th>Price Per Unit</th>
            <th>Purchased Stock</th>
            <th>Manufacture Date</th>
            <th>Expiry Date</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DrugID)</td>
                <td>@Html.DisplayFor(modelItem => item.DrugName)</td>
                <td>Rs.@Html.DisplayFor(modelItem => item.PricePerUnit)</td>
                <td>@Html.DisplayFor(modelItem => item.PurchesedStock)</td>
                <td>@item.ManufactureDate.ToString("yyyy-MM-dd")</td>
                <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                <td class="text-center">
                    <a href="@Url.Action("UpdateDrugs", new { id = item.DrugID })" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a href="@Url.Action("DeleteDrugs", new { id = item.DrugID })" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this drug?');">
                        <i class="fas fa-trash-alt"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Bootstrap JS for table interactivity -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>