@model SPC_Server.Models.Admin

@{
    ViewBag.Title = "AddAdmin";
}

<h2 class="text-primary text-center mb-5"><i class="fas fa-user-plus"></i> Add New Admin</h2>

<div class="container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h4>Admin Information</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AdminID, "Admin ID", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.EditorFor(model => model.AdminID, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AdminID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AdminName, "Admin Name", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.EditorFor(model => model.AdminName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AdminName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AdminUserName, "Username", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.EditorFor(model => model.AdminUserName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AdminUserName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Password, "Password", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Role, "Role", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.DropDownListFor(model => model.Role, new SelectList(new[] { "WarehouseStaff", "ManufacturingPlants" }), "Select Role", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Location, "Location", htmlAttributes: new { @class = "control-label text-secondary" })
                        @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column align-items-center mt-5">
                <button type="submit" class="btn btn-primary mb-2 w-100">Create Admin</button>
                @Html.ActionLink("Back to List", "GetAdmin", null, new { @class = "btn btn-secondary w-100" })
            </div>
        </div>
    }
</div>

<style>
    .container {
        max-width: 700px;
        margin: auto;
        padding: 20px;
        background: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 15px;
    }

    .btn {
        padding: 10px 20px;
    }

    .ml-2 {
        margin-left: 10px;
    }
</style>