@model IEnumerable<SPC_Server.Models.Pharmacy>

@{
    ViewBag.Title = "GetPharmacy";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure it uses your layout
}

<div class="container mt-4">
    <h2 class="text-center mb-3 text-info">Pharmacy List</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-secondary">Pharmacy Inventory</h5>
        <a href="@Url.Action("AddPharmacy", "Home")" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Create New Pharmacy
        </a>
    </div>

    <div>
        <table class="table table-striped ">
            <thead class="bg-info text-white">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.PharmacyID)</th>
                    <th>@Html.DisplayNameFor(model => model.PharmacyName)</th>
                    <th>@Html.DisplayNameFor(model => model.PharmacyType)</th>
                    <th>@Html.DisplayNameFor(model => model.Address)</th>
                    <th>@Html.DisplayNameFor(model => model.ContactEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.ContactPhone)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.PharmacyID)</td>
                        <td>@Html.DisplayFor(modelItem => item.PharmacyName)</td>
                        <td>@Html.DisplayFor(modelItem => item.PharmacyType)</td>
                        <td>@Html.DisplayFor(modelItem => item.Address)</td>
                        <td>@Html.DisplayFor(modelItem => item.ContactEmail)</td>
                        <td>@Html.DisplayFor(modelItem => item.ContactPhone)</td>
                        <td class="text-center" style="width: 10%;">
    <div class="d-flex flex-column">
        <a href="@Url.Action("UpdatePharmacy", new { id = item.PharmacyID })" class="btn btn-warning btn-sm mb-2">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="@Url.Action("DeletePharmacy", new { id = item.PharmacyID })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this Pharmacy?');">
            <i class="fas fa-trash-alt"></i> Delete
        </a>
    </div>
</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        margin: auto;
        padding: 20px;
    }

    .card {
        border-radius: 8px;
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 14px;
    }

    .text-center {
        text-align: center;
    }

    .text-secondary {
        color: #6c757d;
    }

    .bg-info {
        background-color: #17a2b8 !important;
    }

    .text-white {
        color: white !important;
    }

    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
</style>



@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}