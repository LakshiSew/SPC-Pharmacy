@model SPC_Admin.Models.StockAndDrugViewModel

@{
    ViewBag.Title = "StockandDrug";
    Layout = "~/Views/Shared/_Layout2.cshtml"; // Ensures it uses the main layout
}

<h2 class="text-center mb-3 text-info"><i class="fas fa-pills"></i> Stock and Drug Overview</h2>

<table class="table table-striped table-bordered">
    <thead class="bg-info text-white">
        <tr>
            <th>Stock Update ID</th>
            <th>Drug Name</th>
            <th>Current Quantity</th>
            <th>Update Date</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model.StockUpdates)
        {
            <tr>
                <td>@stock.StockUpdateID</td>
                <td>@stock.DrugName</td>
                <td>@stock.CurrentQty</td>

                <td>@(stock.UpdateDate.HasValue ? stock.UpdateDate.Value.ToString("yyyy-MM-dd") : "")</td>

                <td class="text-center">
                    <a href="@Url.Action("EditStock", new { id = stock.StockUpdateID})" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> Update stock
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}


<div class="mt-5"></div> <!-- Add some space between tables -->

<h5 class="text-secondary">Drugs</h5>


<table class="table table-striped table-bordered">
    <thead class="bg-info text-white">
        <tr>
            <th>Drug ID</th>
            <th>Drug Name</th>
            <th>Price Per Unit</th>
            <th>Purchased Stock</th>
            <th>Manufacture Date</th>
            <th>Expiry Date</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var drug in Model.Drugs)
        {
            <tr>
                <td>@drug.DrugID</td>
                <td>@drug.DrugName</td>
                <td>Rs.@drug.PricePerUnit</td>
                <td>@drug.PurchesedStock</td>
                <td>@drug.ManufactureDate.ToString("yyyy-MM-dd")</td>
                <td>@drug.ExpiryDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>


