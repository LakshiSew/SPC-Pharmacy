@model IEnumerable<SPC_Server.Models.TenderProposal>

@{
    ViewBag.Title = "GetTenserProposals";
}

<h2 class="text-center mb-5">Tender Proposals</h2>

<div class="container">
    <table class="modern-table table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.TenderID)</th>
                <th>@Html.DisplayNameFor(model => model.SupplierName)</th>
                <th>@Html.DisplayNameFor(model => model.ProposedPrice)</th>
                <th>@Html.DisplayNameFor(model => model.ProposalDate)</th>
                <th>@Html.DisplayNameFor(model => model.ProposalStatus)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.TenderID)</td>
                    <td>@Html.DisplayFor(modelItem => item.SupplierName)</td>
                    <td>@Html.DisplayFor(modelItem => item.ProposedPrice)</td>
                   

                    <td>@(item.ProposalDate.HasValue ? item.ProposalDate.Value.ToString("yyyy-MM-dd") : "")</td>
                  

                    <td>@Html.DisplayFor(modelItem => item.ProposalStatus)</td>
                    <td class="actions">
                        @using (Html.BeginForm("ConfirmTenderProposal", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", item.TenderProposalID)
                            <button type="submit" value="Confirmed" class="btn-confirm" onclick="return confirm('Are you sure you want to confirm this Tender Proposal?');">Confirm</button>
                        }

                        @using (Html.BeginForm("CancelTenderProposal", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", item.TenderProposalID)
                            <button type="submit" value="Rejected" class="btn-cancel" onclick="return confirm('Are you sure you want to cancel this Tender Proposal?');">Cancel</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    h2 {
        font-size: 24px;
        color: #333;
        font-weight: 600;
        margin-bottom: 30px;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

        .modern-table thead {
            background-color: #007BFF;
            color: #fff;
        }

        .modern-table th,
        .modern-table td {
            padding: 12px 15px;
            text-align: left;
        }

        .modern-table tbody tr {
            border-bottom: 1px solid #ddd;
        }

            .modern-table tbody tr:nth-child(even) {
                background-color: #f9f9f9;
            }

            .modern-table tbody tr:hover {
                background-color: #f1f1f1;
            }

    .actions {
        display: flex;
        gap: 10px;
    }

    .btn-confirm,
    .btn-cancel {
        padding: 8px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.3s ease;
    }

    .btn-confirm {
        background-color: #28a745;
        color: #fff;
    }

        .btn-confirm:hover {
            background-color: #218838;
        }

    .btn-cancel {
        background-color: #dc3545;
        color: #fff;
    }

        .btn-cancel:hover {
            background-color: #c82333;
        }

    .alert {
        padding: 15px;
        border-radius: 4px;
        margin: 20px auto;
        max-width: 600px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
    }

    .alert-error {
        background-color: #f8d7da;
        color: #721c24;
    }

    .close-alert {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: inherit;
    }
</style>



@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
