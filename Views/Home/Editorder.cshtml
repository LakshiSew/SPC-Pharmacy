@model SPC_Server.Models.Order

@{
    ViewBag.Title = "EditOrder";
}

<h2>Edit Order</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Order Details</h4>
        <hr />

        <div class="form-group">
            @Html.LabelFor(model => model.PharmacyName, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.PharmacyName, new { @class = "form-control" }) <!-- Display only -->
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DrugName, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.DrugName, new { @class = "form-control" }) <!-- Display only -->
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Quantity, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.Quantity, new { @class = "form-control" }) <!-- Display only -->
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Status, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } }) <!-- Editable status -->
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Update Status" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to Orders", "getOrders", "Home", null, new { @class = "btn btn-secondary" })
</div>
