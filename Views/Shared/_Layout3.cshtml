
@{
    ViewBag.Title = "_Layout3";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">

    <!-- Custom Styles -->
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa; /* Light background for better contrast */
        }

        /* Sidebar */
        .sidebar {
            background-color: #343a40; /* Dark background for sidebar */
            color: white;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            box-shadow: 2px 0px 5px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between; /* Push content to top and bottom */
            padding-top: 20px; /* Added padding for better spacing */
        }

            .sidebar h2 {
                text-align: center;
                color: #fff;
                font-size: 24px; /* Increased font size */
                padding: 10px;
                margin-bottom: 30px; /* Added margin below the title */
            }

            .sidebar ul {
                list-style: none;
                padding: 0;
                margin: 0;
                width: 100%;
            }

                .sidebar ul li {
                    padding: 4px 10px; /* Increased padding for better touch targets */
                    border-radius: 4px;
                    transition: background-color 0.3s ease;
                    margin-bottom: 10px; /* Increased margin between items */
                }

                    .sidebar ul li.active-link {
                        background-color: #007bff; /* Highlight active link */
                    }

                    .sidebar ul li:hover {
                        background-color: #007bff; /* Change background on hover */
                    }

                    .sidebar ul li a {
                        text-decoration: none;
                        color: white;
                        font-size: 18px; /* Increased font size */
                        display: flex;
                        align-items: center;
                        padding: 10px 15px; /* Increased padding */
                        width: 100%;
                    }

                        .sidebar ul li a i {
                            margin-right: 10px; /* Increased spacing between icon and text */
                            font-size: 20px; /* Increased icon size */
                        }

        /* Logout Button */
        .logout-btn {
            width: 90%;
            padding: 10px;
            background-color: #dc3545; /* Red background for logout */
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
            font-size: 16px;
            margin: 20px auto; /* Added margin for spacing */
            display: block;
            transition: background-color 0.3s ease;
        }

            .logout-btn i {
                margin-right: 8px;
            }

            .logout-btn:hover {
                background-color: #c82333; /* Darker red on hover */
            }

        /* Main Content */
        .main-content {
            margin-left: 260px; /* Space for sidebar */
            padding: 20px;
            transition: margin-left 0.3s ease;
        }

        /* Responsive Design */
        media (max-width: 768px) {
            .sidebar

        {
            width: 200px; /* Adjust sidebar width */
        }

        .main-content {
            margin-left: 210px; /* Adjust main content margin */
        }

        }

        media (max-width: 576px) {
            .sidebar

        {
            width: 100%; /* Full width on small screens */
            height: auto;
            position: relative;
        }

        .main-content {
            margin-left: 0; /* No margin on small screens */
        }

        .sidebar h2 {
            font-size: 20px; /* Smaller font size */
        }

        .sidebar ul li {
            font-size: 16px; /* Smaller font size */
        }

        .logout-btn {
            font-size: 14px; /* Smaller font size */
        }
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Section -->
            <div class="col-md-3 sidebar">
                <div>
                    <h2>Manufacturing Plants Panel</h2>
                    <ul>
                        <li><a href="@Url.Action("ManufacturingPlantsDashboard", "Home")" class="nav-link"><i class="fas fa-home"></i>Home</a></li>
                        <li><a href="@Url.Action("StockAndDrugmanufacture", "Home")" class="nav-link"><i class="fas fa-boxes"></i> Manage Stocks</a></li>
                    </ul>
                </div>

                <!-- Logout Button at the bottom -->
                <button class="logout-btn" onclick="location.href='@Url.Action("Logout", "Home")'">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
            <!-- Main Content Section -->
            <div class="col-md-9 main-content">
                @RenderBody() <!-- This will render the content of the current view -->
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Highlight active page in sidebar
        $(document).ready(function () {
            var currentUrl = window.location.href;
            $('.nav-link').each(function () {
                if (this.href === currentUrl) {
                    $(this).closest('li').addClass('active-link');
                }
            });
        });
    </script>
</body>
</html>
